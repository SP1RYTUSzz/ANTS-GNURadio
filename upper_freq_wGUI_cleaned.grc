options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ANTS_Upper_Freq
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Not titled yet
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: filesink_decimation
  id: variable
  parameters:
    comment: ''
    value: round(samp_rate / vec_len / filesink_freq)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1320, 952.0]
    rotation: 0
    state: enabled
- name: filesink_directory
  id: variable
  parameters:
    comment: 'Directory for File Sink Blocks


      For ANTS Pi5:

      "/home/antfarm/Documents/Antman_GNURadio_Code/Results/"'
    value: r"C:/.ANTS_6-16-26_Test_Results/"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1496, 16.0]
    rotation: 0
    state: enabled
- name: filesink_freq
  id: variable
  parameters:
    comment: ''
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1232, 952.0]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: ''
    value: '2.435E+09'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 80.0]
    rotation: 0
    state: enabled
- name: func_probe_noise
  id: variable_function_probe
  parameters:
    block_id: probe_noise_floor
    comment: ''
    function_args: ''
    function_name: level
    poll_rate: '10'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 712.0]
    rotation: 0
    state: enabled
- name: gain
  id: variable
  parameters:
    comment: ''
    value: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [96, 112.0]
    rotation: 0
    state: enabled
- name: lna_makeup_gain
  id: variable
  parameters:
    comment: 'Set LNA gain here.

      This is used to normalize the gain added by LNA.'
    value: '-12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1232, 16.0]
    rotation: 0
    state: enabled
- name: samp_rate
