options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: upper_freq
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Not titled yet
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: filesink_decimation
  id: variable
  parameters:
    comment: ''
    value: round(samp_rate / vec_len / filesink_freq)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1320, 952.0]
    rotation: 0
    state: enabled
- name: filesink_directory
  id: variable
  parameters:
    comment: 'Directory for File Sink Blocks


      For ANTS Pi5:

      "/home/antfarm/Documents/Antman_GNURadio_Code/Results/"'
    value: r"/home/antfarm/Documents/Antman_GNURadio_Code/Results/"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 16.0]
    rotation: 0
    state: enabled
- name: filesink_freq
  id: variable
  parameters:
    comment: ''
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1232, 952.0]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: ''
    value: '2.435E+09'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [128, 120.0]
    rotation: 0
    state: enabled
- name: func_probe_noise
  id: variable_function_probe
  parameters:
    block_id: probe_noise_power
    comment: ''
    function_args: ''
    function_name: level
    poll_rate: '10'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 728.0]
    rotation: 0
    state: enabled
- name: lna_makeup_gain_dB
  id: variable
  parameters:
    comment: 'Set LNA gain here.

      This is used to normalize the gain added by LNA.'
    value: '-12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1120, 24.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '30.72E+06'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [48, 120.0]
    rotation: 0
    state: enabled
- name: threshold0_dB
  id: variable
  parameters:
    comment: ''
    value: '3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 696.0]
    rotation: 0
    state: enabled
- name: threshold1_dB
  id: variable
  parameters:
    comment: ''
    value: '6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 760.0]
    rotation: 0
    state: enabled
- name: threshold2_dB
  id: variable
  parameters:
    comment: ''
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 824.0]
    rotation: 0
    state: enabled
- name: upper_or_lower
  id: variable
  parameters:
    comment: 'Directory for File Sink Blocks


      For ANTS Pi5:

      "/home/antfarm/Documents/Antman_GNURadio_Code/Results/"'
    value: '"upper"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 16.0]
    rotation: 0
    state: enabled
- name: vec_len
  id: variable
  parameters:
    comment: "FFT sizes and other parameters.\nSet between 1024 and 8192. \nThe higher\
      \ the higher resolutioneach data points."
    value: '4096'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 16.0]
    rotation: 0
    state: enabled
- name: blocks_add_const_vxx_0
  id: blocks_add_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: lna_makeup_gain_dB
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1248, 376.0]
    rotation: 0
    state: enabled
- name: blocks_add_const_vxx_1
