- name: blocks_threshold_ff_0
  id: blocks_threshold_ff
  parameters:
    affinity: ''
    alias: ''
    comment: 'This convert (probe_noise_floor, LNA_makeup_gain, and_threshold0_dB)
      to linear power and compare

      10**((func_probe_noise + threshold0_dB - lna_makeup_gain)/10)'
    high: 10**((func_probe_noise + threshold0_dB - lna_makeup_gain_dB)/10)
    init: '0'
    low: 10**((func_probe_noise + threshold0_dB - lna_makeup_gain_dB)/10)
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
